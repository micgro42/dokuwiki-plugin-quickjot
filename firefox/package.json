{
  "name": "quickjot-firefox",
  "version": "0.3.1",
  "description": "Firefox extension for the DokuWiki quickjot plugin",
  "private": true,
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "web-ext lint --ignore-files package.json package-lock.json",
