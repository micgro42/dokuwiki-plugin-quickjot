{
  "manifest_version": 3,
  "name": "QuickJot",
  "version": "0.1.0",
  "description": "Jot a timestamped note onto today's DokuWiki journal page.",

  "browser_specific_settings": {
    "gecko": {
      "id": "quickjot@grosse.dev",
      "strict_min_version": "109.0"
    }
  },

  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["*://*/*"],

  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },

  "action": {
    "default_title": "Add a note to today's journal",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Open the QuickJot note box"
    }
  }
}
